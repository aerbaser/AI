{
  "memory": {
    "backend": "qmd",
    "citations": "auto",
    "qmd": {
      "command": "~/.openclaw/bin/qmd-voyage",
      "searchMode": "search",
      "includeDefaultMemory": false,
      "paths": [
        {
          "path": "~/.openclaw/shared-memory",
          "name": "shared-memory",
          "pattern": "**/*.md"
        }
      ],
      "sessions": {
        "enabled": false
      }
    }
  },
  "plugins": {
    "allow": [
      "lossless-claw",
      "openclaw-engram",
      "telegram"
    ],
    "entries": {
      "lossless-claw": {
        "enabled": true
      },
      "openclaw-engram": {
        "config": {
          "memoryOsPreset": "balanced",
          "rerankEnabled": false,
          "qmdEnabled": true,
          "qmdDaemonEnabled": true,
          "qmdPath": "~/.openclaw/bin/qmd-voyage",
          "lcmEnabled": false,
          "localLlmEnabled": true,
          "localLlmUrl": "http://127.0.0.1:4321",
          "localLlmModel": "openai-codex/gpt-5.4-mini",
          "captureMode": "hybrid",
          "recallBudgetChars": 32000,
          "conversationIndexEnabled": true,
          "sharedContextEnabled": true,
          "sharedContextDir": "~/.openclaw/shared-memory",
          "sharedContextMaxInjectChars": 8000,
          "modelSource": "plugin"
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "memorySearch": {
        "enabled": true,
        "sources": [
          "memory"
        ],
        "extraPaths": [
          "~/.openclaw/shared-memory"
        ],
        "provider": "voyage",
        "model": "voyage-3-large",
        "fallback": "local"
      }
    }
  }
}
